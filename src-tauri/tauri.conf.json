{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flow Coding",
  "version": "0.2.2",
  "identifier": "com.smallcat.rs-flow-coding",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Flow Coding V.0.2.2",
        "width": 1500,
        "height": 920,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
