  <diagram id="chat-flow" name="飞书问答流程">
    <mxGraphModel dx="648" dy="477" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="2100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;TIS-Bot 飞书问答流程&lt;/b&gt;（蓝色=用户新增待确认 → 橙色虚线=已确认待实现 → 默认色=已实现）" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" parent="1" vertex="1">
          <mxGeometry x="40" y="10" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="飞书用户发消息" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="380" y="60" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="服务端长连接收到事件&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;飞书同时提供：发送人 ID、群 ID、应用 ID&lt;br&gt;（平台给的，用户改不了）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="340" y="130" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="持久去重&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;重复投递 / 短暂重连：不重复判断、不重复推理&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="340" y="225" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="消息来源？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="380" y="310" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g0" value="群文字消息写入内存窗口&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;每群最近 10 条，含未 @ 的消息；不入库，重启清空&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="20" y="325" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="@ 了本 bot？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="40" y="420" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="引用回复了 bot 的消息？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="40" y="530" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="本群最近 10 条消息内&lt;br&gt;有 bot 与此人的问答？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="30" y="650" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="Jev 判定为续问&lt;br&gt;且置信度 ≥ 阈值？&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;阈值默认 0.8，服务设置可调&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="30" y="780" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="x1" value="丢弃不回答&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;不发占位、不推理&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;" parent="1" vertex="1">
          <mxGeometry x="80" y="910" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="先发送占位「🤔 思考中…」&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;私聊普通消息，群聊引用原问题&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="340" y="450" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="排队&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;同一会话串行；不同会话最多 5 个并发、32 个等待&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="340" y="540" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="读取历史上下文&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;相邻轮次 2 小时内连续；合计 ≤ 20 万字符&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="340" y="630" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;【待实现】附身份小纸条&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;提问人 ID、群 ID（私聊无）、应用 ID&lt;br&gt;来自服务端，不经授权、不调工具&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="340" y="720" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Agent 已启用，且&lt;br&gt;当前身份有可用工具？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="360" y="980" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="普通问答&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;单轮纯文本，不带任何工具&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="60" y="1000" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="Agent 循环：模型推理&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;可见：技能目录 + load_skill + 已加载技能的工具&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="340" y="1120" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="模型要调用工具？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="380" y="1210" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="服务端校验通过？&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;技能已加载 · 技能∩开关∩身份授权&lt;br&gt;· 预算 8 轮 / 16 次 / 5 分钟&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="720" y="1195" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="执行&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;load_skill：返回技能步骤&lt;br&gt;业务工具：固定只读 SELECT&lt;br&gt;（任务履历 / 通知回执）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="1060" y="1220" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="拒绝结果&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;超预算则结束本轮并报失败&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="760" y="1360" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="结果写审计 agent.sqlite3&lt;br&gt;并回给模型" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1060" y="1120" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n13" value="得到最终答案&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;生成失败则答案为失败提示&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="340" y="1460" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n14" value="编辑占位消息为答案&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;编辑失败 → 按私聊/群聊规则新发&lt;br&gt;超长 → 按 15000 字节分段&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="340" y="1550" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n15" value="保存问答记录 ai_turns&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;完整送达的才进入后续上下文&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="340" y="1650" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n16" value="结束" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="400" y="1740" width="160" height="50" as="geometry" />
