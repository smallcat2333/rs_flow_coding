        <mxCell id="note3" value="&lt;b&gt;安全边界&lt;/b&gt;&lt;br&gt;身份只取自飞书事件，模型和工具参数都不能改。&lt;br&gt;每次工具调用都重新检查最新授权。" style="shape=note;whiteSpace=wrap;html=1;align=left;spacingLeft=8;size=14;fillColor=#f5f5f5;strokeColor=#999999;" parent="1" vertex="1">
          <mxGeometry x="680" y="130" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="note4" value="&lt;b&gt;顺序要点&lt;/b&gt;&lt;br&gt;去重在判定之前：重复投递不重复判断、不重复推理。&lt;br&gt;占位只在判定「回答」后发送，群里不刷屏。" style="shape=note;whiteSpace=wrap;html=1;align=left;spacingLeft=8;size=14;fillColor=#f5f5f5;strokeColor=#999999;" parent="1" vertex="1">
          <mxGeometry x="680" y="225" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="note5" value="&lt;b&gt;群聊续问判定（规则在前，模型在后）&lt;/b&gt;&lt;br&gt;① @ 本 bot：直接回答。&lt;br&gt;② 引用回复 bot 的占位或答案：直接回答，不调模型。&lt;br&gt;③ 最近 10 条 = 本群最近 10 条消息（所有人），&lt;br&gt;　 其中无 bot 回答过此人 → 丢弃，不调模型。&lt;br&gt;④ 其余调 Jev：Magpie &lt;code&gt;POST /v1/systemone&lt;/code&gt;，&lt;br&gt;　 model=typesafe/jev-latest，Choice yes/no，约 1.3 秒。&lt;br&gt;Jev 失败或置信度不足 → 丢弃。判定在后台进行，不阻塞 ACK。" style="shape=note;whiteSpace=wrap;html=1;align=left;spacingLeft=8;size=14;fillColor=#f5f5f5;strokeColor=#999999;" parent="1" vertex="1">
          <mxGeometry x="680" y="420" width="420" height="190" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="&lt;b&gt;例：问「我的ID / 群ID」&lt;/b&gt;&lt;br&gt;有纸条后，模型在第一次推理就直接作答，&lt;br&gt;走「模型要调用工具？→ 否」，不查库、不需授权。&lt;br&gt;私聊问群 ID：回答私聊没有群 ID。&lt;br&gt;问别人的 ID：只能看到提问人自己的。" style="shape=note;whiteSpace=wrap;html=1;align=left;spacingLeft=8;size=14;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="680" y="700" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e24" style="html=1;dashed=1;endArrow=none;strokeColor=#d79b00;" parent="1" source="note1" target="n7" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="&lt;b&gt;取消与超时&lt;/b&gt;&lt;br&gt;停止 Bot / 服务：已有占位约 3 秒内编辑为取消提示并记录。&lt;br&gt;单次问答 5 分钟超时；失败不自动重试。" style="shape=note;whiteSpace=wrap;html=1;align=left;spacingLeft=8;size=14;fillColor=#f5f5f5;strokeColor=#999999;" parent="1" vertex="1">
          <mxGeometry x="680" y="1550" width="360" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>